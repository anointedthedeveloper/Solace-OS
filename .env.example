# Copy to .env and fill in. Placeholders only — never commit real secrets.

# ── Backend (Spring Boot) ──────────────────────────────────────────
SOLACE_DB_URL=jdbc:postgresql://localhost:5432/solace
SOLACE_DB_USER=solace
SOLACE_DB_PASSWORD=change-me
SOLACE_PORT=8080
# true whenever the site is served over HTTPS (production). false only for local plain-HTTP.
SOLACE_COOKIE_SECURE=true
# Comma-separated origins for split-origin deployments; leave empty for same-origin (recommended).
SOLACE_CORS_ALLOWED_ORIGINS=
SOLACE_SESSION_TIMEOUT=8h
SOLACE_BCRYPT_STRENGTH=12
SOLACE_FILE_MAX_BYTES=10485760
SOLACE_FILE_QUOTA_BYTES=104857600
SOLACE_UPLOAD_MAX_FILE=10MB
SOLACE_UPLOAD_MAX_REQUEST=11MB
# Rate limits (per window, default 15 min)
SOLACE_RL_LOGIN_PER_IP=20
SOLACE_RL_LOGIN_FAILS_PER_USER=5
SOLACE_RL_REGISTER_PER_IP=5
SOLACE_RL_WINDOW_SECONDS=900
# Interactive API docs at /swagger-ui.html — keep false in production
SOLACE_API_DOCS=false
SPRING_PROFILES_ACTIVE=

# ── docker compose ─────────────────────────────────────────────────
SOLACE_HTTP_PORT=8088

# ── Frontend (read at build time, prefix VITE_) ────────────────────
# API base URL. Default "/api" = same origin (behind nginx / the Vite proxy).
VITE_API_BASE_URL=/api
# Serve the app under a sub-path, e.g. /solace/
VITE_BASE_PATH=/
# Where `npm run dev` / `vite preview` proxy /api to
VITE_DEV_PROXY_TARGET=http://localhost:8080
